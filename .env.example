# Copy this file to .env and fill in local values. Never commit .env.
#
# ⚠️ 线上部署请在平台的「环境变量」里逐条填，不要依赖这个文件 ——
#    .dockerignore 会把 .env 挡在镜像外，容器里根本读不到它。

# ---- 必须逐字正确的三项 ----
# feature_extractor.py:55 用**两个条件**判定该说哪种协议：
#     LC_BRIDGE 去掉尾斜杠后以 "api.openai-next.com" 结尾
#     且 LC_API_KEY 以 "sk-" 开头
# 两个都满足才走 OpenAI 方言（POST {LC_BRIDGE}/v1/chat/completions），
# 否则一律走 Anthropic 方言（POST {LC_BRIDGE}/v1/messages）。
# 判定失败不会报错，只会**静默**换协议，表现为「LLM 返回空内容」。
#   · 加 /v1、或换成别的域名 → endswith 不成立 → 走错协议
#   · 尾斜杠是安全的：代码里有 .rstrip("/") 兜着（旧说法「不要加尾斜杠」说得过重）
#   · 密钥不以 sk- 开头 → 即使域名写对了也会走错协议（这条最容易漏）
LC_BRIDGE=https://api.openai-next.com
LC_MODEL=gpt-4o-mini
LC_API_KEY=sk-your_key_here

# ---- 身份与容量 ----
# 留空则首次使用时自动生成一份存到 data/.secret_key。
# **线上必须由平台注入一个固定值**，否则每次重新部署密钥都变，
# 所有人的匿名身份当场作废（见 README 第一节第 5 步）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
LC_SECRET_KEY=

# 匿名身份上限；超限只淘汰 users.json 里最早的那条记录，不删磁盘文件。
LC_MAX_GUESTS=2000

# ---- 超时（线上要盯这两条）----
# 平台的「请求超时」必须大于 LC_DISCOVER_TIMEOUT，否则「发现同源」跑到一半被掐断。
# 推荐：平台请求超时设 300，这里保持 240。
LC_TIMEOUT=180
LC_DISCOVER_TIMEOUT=240
LC_REVIEW_SUMMARY_TIMEOUT=60

# ---- 可选，默认值通常不用改 ----
LC_THINKING=none
LC_SAMPLES=3
LC_METHOD=cosine
LC_THRESHOLD=0.85
LC_GAMMA=0.06
