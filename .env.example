# Copy this file to .env and fill in local values. Never commit .env.
# LC_BRIDGE 必须原样填写，不要加 /v1、不要加尾斜杠、不要换成别的域名。
# 原因：feature_extractor.py 靠「域名后缀是否等于 api.openai-next.com」来判断
# 该说 OpenAI 方言还是 Anthropic 方言；网址写法一变就会静默走错协议，
# 表现为「LLM 返回空内容」，且报错信息完全指不到原因。
LC_BRIDGE=https://api.openai-next.com
LC_MODEL=gpt-4o-mini
LC_API_KEY=your_api_key_here

# 知乎开放平台 Access Secret（用于“知乎搜索”）。在 https://developer.zhihu.com/profile 创建。
# 只配置在后端环境中，不要写入前端或提交真实值到 Git。
ZHIHU_ACCESS_SECRET=your_zhihu_access_secret_here

# 知乎 OAuth（公共部署只由站点管理员配置一次；每位用户仍需在知乎页面单独授权）
# 回调地址必须与知乎开放平台后台登记的地址完全一致。
ZHIHU_OAUTH_CLIENT_ID=your_oauth_client_id
ZHIHU_OAUTH_CLIENT_SECRET=your_oauth_client_secret
ZHIHU_OAUTH_AUTHORIZE_URL=https://www.zhihu.com/oauth/authorize
ZHIHU_OAUTH_TOKEN_URL=https://www.zhihu.com/oauth/token
ZHIHU_OAUTH_REDIRECT_URI=https://你的域名/api/zhihu/oauth/callback
# 以知乎开放平台实际授予的 scope 为准；不要自行猜测权限名。
ZHIHU_OAUTH_SCOPE=read

# Optional runtime settings
LC_TIMEOUT=180
LC_DISCOVER_TIMEOUT=240
LC_THINKING=none
LC_SAMPLES=3
LC_METHOD=cosine
# 允许共享核心机制、实现方式不同的跨学科映射进入报告。
LC_THRESHOLD=0.72
LC_GAMMA=0.06
