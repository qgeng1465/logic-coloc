# Copy this file to .env and fill in local values. Never commit .env.
LC_BRIDGE=https://api.deepseek.com/anthropic
LC_MODEL=deepseek-chat
LC_API_KEY=your_api_key_here

# Optional runtime settings
LC_TIMEOUT=180
LC_DISCOVER_TIMEOUT=240
LC_THINKING=none
LC_SAMPLES=3
LC_METHOD=cosine
LC_THRESHOLD=0.85
LC_GAMMA=0.06
